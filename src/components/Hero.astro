---
const heroImage = '/hero-bedroom.png';
---

<section class="hero">
  <img class="hero__image" src={heroImage} alt="" aria-hidden="true" />
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__card">
    <h1 class="hero__title">A fresh look<br />is on the way</h1>
    <p class="hero__body">
      Our website is currently under construction.<br />
      Scroll down to explore while we wrap up the finishing touches.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--navbar-h));
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.05);
    z-index: 1;
    pointer-events: none;
  }

  .hero__card {
    position: absolute;
    right: 64px;
    bottom: 112px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 663px;
    padding: 52px 36px;
    background-color: rgba(48, 74, 61, 0.9);
    border-radius: 16px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: 72px;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--color-secondary);
    margin: 0;
  }

  .hero__body {
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 1.6;
    color: var(--color-secondary);
    margin: 0;
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      align-items: center;
      justify-content: center;
      height: auto;
      min-height: calc(100vh - var(--navbar-h));
      padding: 64px 20px;
    }

    .hero__overlay {
      background-color: rgba(0, 0, 0, 0.4);
    }

    /* The narrow hero crops to ~1/3 of the image width. Centering lands on the
       bare wall between the bed and the nightstand, so bias left onto the bed
       (its midpoint sits at ~33% of the source, the headboard ends at ~66%). */
    .hero__image {
      object-position: 24% 60%;
    }

    .hero__card {
      position: static;
      width: 100%;
      padding: 8px;
      gap: 16px;
      text-align: center;
    }

    .hero__title {
      font-size: clamp(2rem, 10.67vw, 2.5rem);
    }

    .hero__body {
      font-size: 18px;
    }
  }
</style>
